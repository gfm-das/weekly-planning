# DataEase (the portal's Dashboards). Copy nothing by hand: dataease/init-env.ps1 writes dataease/.env with
# generated values. Never commit or print .env.

# MySQL for DataEase's own metadata (dashboards, charts, datasets). Letters and digits, 32 characters.
DE_MYSQL_ROOT_PASSWORD=REPLACE_WITH_GENERATED_VALUE
DE_MYSQL_PASSWORD=REPLACE_WITH_GENERATED_VALUE

# The one DataEase account, "admin" (the Community Edition has no other accounts). 8-20 characters with a-z, A-Z,
# 0-9 and one of @ - _ . + (DataEase's rule). Only the gate container and seed-dashboards.ps1 use it; on DataEase's
# very first start the gate replaces DataEase's published default password with this one. People never type it:
# Dashboards open from the portal.
DE_ADMIN_PASSWORD=REPLACE_WITH_GENERATED_VALUE

# Signs the portal's Dashboards cookie (gfm_dataease). portal-api/.env holds the same value as DATAEASE_PROXY_SECRET
# (dataease/init-env.ps1 -SyncPortalApi puts it there). At least 32 letters and digits.
GFM_DATAEASE_PROXY_SECRET=REPLACE_WITH_GENERATED_VALUE

# The read-only database login gfm_dashboard_reader (migrations 018/025). init-env.ps1 generates the password; set it on
# the database once with dataease/set-reader-password.ps1.
GFM_DASHBOARD_READER_PASSWORD=REPLACE_WITH_GENERATED_VALUE

# Optional (defaults shown):
# The mission's time zone (an IANA name such as America/Denver). Default: Europe/Berlin.
# GFM_TIME_ZONE=Europe/Berlin
# This computer's address in the office network: used in the two address lists below when they are not set.
# GFM_HOST_IP=192.168.1.20
# GFM_DATAEASE_PORT=8088
# GFM_DATAEASE_BIND=0.0.0.0
# The portal addresses that may show DataEase in their frame. Keep the double quotes around the whole value: without
# them compose keeps only 'self', and the Dashboards tab stays blank. If the server's LAN address changes, change it
# here and in GFM_DATAEASE_ORIGINS, then: docker compose -p gfm-dataease -f dataease/compose.yml up -d
# GFM_PORTAL_FRAME_ORIGINS="'self' http://localhost:8070 http://127.0.0.1:8070 http://192.168.1.20:8070 https://example.org https://www.example.org"
# GFM_DATAEASE_ORIGINS=http://localhost:8088,http://127.0.0.1:8088,http://192.168.1.20:8088,https://dashboards.example.org
# GFM_DATAEASE_DB_NETWORK=gfm-network
# GFM_DATAEASE_DB_UPSTREAM=gfm-beta-supabase-db-1:5432
# GFM_DATAEASE_DB_NAME=postgres

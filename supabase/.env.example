# ============================================================
# GFM Platform - Supabase Environment
# Copy this file to .env and replace CHANGE_ME values.
# Never commit the real .env file.
# ============================================================

# Optional: this computer address in the office network, used by supabase/beta-override.yml for the sign-in redirect
# list. The default is this server's. GFM_HOST_IP=192.168.1.20
# The address people open the portal on, which the links in invitation and password emails use: https://<public domain>
# when the mission has one, else http://<this computer>:8070. And the public domain itself (empty: none).
GFM_SITE_URL=http://localhost:8070
GFM_PUBLIC_DOMAIN=
ADDITIONAL_REDIRECT_URLS=http://localhost:8070/**,http://localhost:8090,http://localhost:8090/**
DISABLE_SIGNUP=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=false
ENABLE_PHONE_SIGNUP=false
FUNCTIONS_VERIFY_JWT=false
JWT_EXPIRY=3600
MAILER_SUBJECTS_CONFIRMATION=CHANGE_ME
MAILER_SUBJECTS_EMAIL_CHANGE=CHANGE_ME
MAILER_SUBJECTS_INVITE=CHANGE_ME
MAILER_SUBJECTS_MAGIC_LINK=CHANGE_ME
MAILER_SUBJECTS_RECOVERY=CHANGE_ME
MAILER_TEMPLATES_CONFIRMATION=CHANGE_ME
MAILER_TEMPLATES_EMAIL_CHANGE=CHANGE_ME
MAILER_TEMPLATES_INVITE=CHANGE_ME
MAILER_TEMPLATES_MAGIC_LINK=CHANGE_ME
MAILER_TEMPLATES_RECOVERY=CHANGE_ME
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
OPENAI_API_KEY=CHANGE_ME
POOLER_DB_POOL_SIZE=5
POSTGRES_DB=postgres
POSTGRES_HOSTNAME=supabase-db
POSTGRES_PORT=5432
SECRET_PASSWORD_REALTIME=CHANGE_ME
SERVICE_PASSWORD_ADMIN=CHANGE_ME
SERVICE_PASSWORD_JWT=CHANGE_ME
SERVICE_PASSWORD_LOGFLARE=CHANGE_ME
SERVICE_PASSWORD_LOGFLAREPRIVATE=CHANGE_ME
SERVICE_PASSWORD_MINIO=CHANGE_ME
SERVICE_PASSWORD_PGMETACRYPTO=CHANGE_ME
SERVICE_PASSWORD_POSTGRES=CHANGE_ME
SERVICE_PASSWORD_SUPAVISORSECRET=CHANGE_ME
SERVICE_PASSWORD_VAULTENC=CHANGE_ME
SERVICE_ROLE_KEY_ASYMMETRIC=CHANGE_ME
SERVICE_SUPABASEANON_KEY=CHANGE_ME
SERVICE_SUPABASESERVICE_KEY=CHANGE_ME
SERVICE_URL_SUPABASEKONG=CHANGE_ME
SERVICE_USER_ADMIN=CHANGE_ME
SERVICE_USER_MINIO=CHANGE_ME
SMTP_ADMIN_EMAIL=CHANGE_ME
SMTP_HOST=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_PORT=587
SMTP_SENDER_NAME=CHANGE_ME
SMTP_USER=CHANGE_ME
STORAGE_TENANT_ID=storage-single-tenant
STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project
SUPERSET_DASHBOARD_ID=CHANGE_ME
SUPERSET_PASSWORD=CHANGE_ME
SUPERSET_URL=CHANGE_ME
SUPERSET_USERNAME=CHANGE_ME

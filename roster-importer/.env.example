# Use the Supabase Postgres connection reachable from this container.
# Example when attached to the Supabase Docker network:
# postgresql://postgres:YOUR_DB_PASSWORD@gfm-beta-supabase-db-1:5432/postgres
DATABASE_URL=postgresql://postgres:CHANGE_ME@gfm-beta-supabase-db-1:5432/postgres

# The mission's number in public.missions (the installer makes it 1; the Frankfurt system is 2).
MISSION_ID=1

# The mission's public web name, for example example.org. Empty: no public address (the office network only).
# DA Management then answers on management.<name> and trusts https://<name> and https://www.<name>.
GFM_PUBLIC_DOMAIN=

# The mission's time zone (an IANA name such as America/Denver). Default: Europe/Berlin.
GFM_TIME_ZONE=Europe/Berlin

# Password protecting the importer web page.
IMPORTER_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Random application secret.
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
SUPABASE_AUTH_INTERNAL_URL=http://gfm-beta-supabase-kong-1:8000
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_TO_BETA_SERVICE_ROLE_KEY
PASSWORD_REDIRECT_URL=http://192.168.1.20:8070/

# Delete retired makes a database backup first (pg_dump) into the backups folder next to the programs (docker-compose.yml).
# Leave BACKUP_COMMAND empty to use pg_dump. Change it only if pg_dump cannot reach the database from this program; it must
# write a PostgreSQL custom-format dump to {file}. The backup is read back with pg_restore --list.
BACKUP_COMMAND=

# DA Management > Links to web services: where each card leads. Empty keeps the service's public sign-in page; "off" hides the
# card. Never put a password, key or token in an address: such an address is not shown.
WEB_LINK_GMAIL=
WEB_LINK_PORKBUN=
WEB_LINK_CLOUDFLARE=
# DA Management > Wiki: the button leads to the portal's wiki. Empty works it out (this computer's name, the portal's port, /wiki/);
# "off" hides the button; or write the wiki's address. PORTAL_PORT is the portal's port when it is not 8070.
WEB_LINK_WIKI=
PORTAL_PORT=8070

# Data uploads > Finding export: the secret that turns Church person ids into person codes (at least 16
# characters, random, e.g. from: python -c "import secrets; print(secrets.token_hex(32))"). Set it once and never
# change it: a new secret makes every person look new, and DA Management then refuses the next finding upload.
PERSON_KEY_SECRET=

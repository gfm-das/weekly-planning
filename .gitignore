# ============================================================
# GFM Platform - secrets and local configuration
# ============================================================

# Real environment files
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Historical/local environment snapshots
*.env.before-local
*.env.before-launch
*.env.before-*
*.before-local
*.before-launch

# Migration source material copied from Coolify
# Contains host-specific configuration and may contain secrets.
legacy/

# Generated inspection reports
compose-validation.txt
local-safety-scan.txt
needs-review.txt

# Local backup artifacts
backups/*
!backups/.gitkeep
!backups/README.md

# Database dump / archive formats
# Do NOT globally ignore *.sql because schema migrations and
# Supabase initialization SQL belong in source control.
*.dump
*.backup
*.bak
*.tar
*.tar.gz
*.zip

# Explicit SQL dump locations
backups/**/*.sql
*.sql.gz

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

# Node
node_modules/

# Python
__pycache__/
*.pyc
.tmp-*
.verify-*
.venv/
venv/

# Logs
*.log


# Added before first push (audit 2026-09-25)
*.env
!*.env.example
*.before-*
original-*
*.pre-*
docs/.qa-*
.inspect-*
.probe-*
tmp_*
tmp-*
*.sql.bak

# The updater's own files on this computer (round 7, updater/gfm-updater.ps1): its settings, the requests from
# DA Management > Updates, its status and its logs
updater/settings.json
updater/requests/
updater/status/
updater/logs/

# The installer's answers (they hold the first password) and its logo: never commit
install/.work/
# The Cloudflare tunnel's token and the routes list the installer writes
cloudflared/ROUTES.txt

# Local wiki screenshot previews (not part of the site)
wiki-preview/


# Wiki browser-edit log (server-local; sync deliberately)
wiki/edit-log.jsonl


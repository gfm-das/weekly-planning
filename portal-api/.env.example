DATABASE_URL=postgresql://postgres:REPLACE@gfm-beta-supabase-db-1:5432/postgres
SUPABASE_URL=http://gfm-beta-supabase-kong-1:8000
SUPABASE_SERVICE_ROLE_KEY=REPLACE
PORTAL_SERVICE_KEY=REPLACE_WITH_RANDOM_SHARED_SECRET
VAPID_PRIVATE_KEY=REPLACE
VAPID_PUBLIC_KEY=REPLACE
VAPID_SUBJECT=mailto:data@gfm.local
# Signs the Dashboards (DataEase) sign-in cookie: the same value as GFM_DATAEASE_PROXY_SECRET in dataease/.env
# (powershell -File dataease/init-env.ps1 -SyncPortalApi writes it here). portal-api refuses the example value.
DATAEASE_PROXY_SECRET=REPLACE_WITH_THE_VALUE_FROM_DATAEASE_ENV
# The mission's public web name, for example example.org (the Dashboards cookie is then set for that domain).
# Empty: no public address, the office network only. The same value in every .env that has this line.
GFM_PUBLIC_DOMAIN=
# The mission's time zone (an IANA name such as America/Denver): weeks, Sunday reminders and shown times follow it.
# Default Europe/Berlin. The same value in every .env that has this line.
GFM_TIME_ZONE=Europe/Berlin

# Wiki editing (optional). Mount wiki/ at this path in compose; Save rebuilds out/ here.
# WIKI_DIR=/data/wiki
# WIKI_GIT_COMMIT=0

# Existing Beta Supabase service role key; do not expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Must match the portal API's internal service key.
PORTAL_SERVICE_KEY=
# The mission's public web name, for example example.org: Presentations then also answers on presentations.<name> and
# decks.<name>. Empty: no public address. The mission's number in public.missions:
GFM_PUBLIC_DOMAIN=
MISSION_ID=1
PRESENTATIONS_PORTAL_ORIGINS=http://localhost:8070,http://127.0.0.1:8070,http://192.168.1.20:8070

# Optional settings of slidev/slidev-compose.yml (the defaults are this server's; set them BEFORE the first start):
# GFM_SLIDEV_CONTAINER=slidev
# The Docker volume with the decks. Create it once: docker volume create <name>
# GFM_SLIDEV_VOLUME=slidev-data
# This computer's address in the office network (used in PRESENTATIONS_PORTAL_ORIGINS when that is not set).
# GFM_HOST_IP=192.168.1.20

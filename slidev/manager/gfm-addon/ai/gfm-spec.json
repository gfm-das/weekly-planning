 "layouts": [
  {
   "name": "gfm-chart-insight",
   "description": "A chart on the left and what it means on the right. Put the chart first, then a line with ::right:: and the message.",
   "slots": [
    "default",
    "right"
   ],
   "props": [
    {
     "name": "heading",
     "type": "string",
     "label": "Slide title"
    },
    {
     "name": "kicker",
     "type": "string",
     "label": "Label above the title"
    }
   ]
  },
  {
   "name": "gfm-comparison",
   "description": "Two things side by side, such as this week and last week, or two zones. Put the first, then a line with ::right:: and the second.",
   "slots": [
    "default",
    "right"
   ],
   "props": [
    {
     "name": "heading",
     "type": "string",
     "label": "Slide title"
    },
    {
     "name": "kicker",
     "type": "string",
     "label": "Label above the title"
    },
    {
     "name": "leftTitle",
     "type": "string",
     "label": "Heading of the left side"
    },
    {
     "name": "rightTitle",
     "type": "string",
     "label": "Heading of the right side"
    }
   ]
  },
  {
   "name": "gfm-cover",
   "description": "Opening slide. A big title (a # heading), a line under it, a small label above and a footer line.",
   "slots": [
    "default"
   ],
   "props": [
    {
     "name": "kicker",
     "type": "string",
     "label": "Label above the title"
    },
    {
     "name": "footer",
     "type": "string",
     "label": "Footer line (for example the mission or the date)"
    }
   ]
  },
  {
   "name": "gfm-freeform",
   "description": "A blank slide for placing things freely - drag, resize and rotate anything. Use it when no other layout fits.",
   "slots": [
    "default"
   ],
   "props": []
  },
  {
   "name": "gfm-full-chart",
   "description": "One chart, as large as the slide allows, with a title and an optional source line. Put a chart (height about 360) in the slide.",
   "slots": [
    "default"
   ],
   "props": [
    {
     "name": "heading",
     "type": "string",
     "label": "Slide title"
    },
    {
     "name": "kicker",
     "type": "string",
     "label": "Label above the title"
    },
    {
     "name": "caption",
     "type": "string",
     "label": "Line under the chart (for example the source or the weeks shown)"
    }
   ]
  },
  {
   "name": "gfm-hero",
   "description": "One message, large and centred - a statement, a big number or a question for the whole group.",
   "slots": [
    "default"
   ],
   "props": [
    {
     "name": "kicker",
     "type": "string",
     "label": "Label above the message"
    }
   ]
  },
  {
   "name": "gfm-image-message",
   "description": "A picture beside a message. The picture fills one side of the slide; the text sits on the other.",
   "slots": [
    "default"
   ],
   "props": [
    {
     "name": "image",
     "type": "string",
     "label": "Picture (an address, or a file from the assets panel)"
    },
    {
     "name": "imageSide",
     "type": "'left' | 'right'",
     "label": "Side of the picture",
     "options": [
      "left",
      "right"
     ]
    },
    {
     "name": "kicker",
     "type": "string",
     "label": "Label above the text"
    }
   ]
  },
  {
   "name": "gfm-kpi-grid",
   "description": "A set of key numbers. Put a GfmKpiGrid (the mission's key indicators) or several GfmBigNumber in the slide.",
   "slots": [
    "default"
   ],
   "props": [
    {
     "name": "heading",
     "type": "string",
     "label": "Slide title"
    },
    {
     "name": "kicker",
     "type": "string",
     "label": "Label above the title"
    },
    {
     "name": "note",
     "type": "string",
     "label": "Line under the numbers"
    }
   ]
  },
  {
   "name": "gfm-section",
   "description": "Starts a new part of the presentation. A big heading on a teal background, with an optional label such as \"Part 2\".",
   "slots": [
    "default"
   ],
   "props": [
    {
     "name": "kicker",
     "type": "string",
     "label": "Label above the heading"
    }
   ]
  },
  {
   "name": "gfm-three-column",
   "description": "Three equal cards, each with a heading and a few lines. Separate the cards with ::middle:: and ::right::.",
   "slots": [
    "default",
    "middle",
    "right"
   ],
   "props": [
    {
     "name": "heading",
     "type": "string",
     "label": "Slide title"
    },
    {
     "name": "kicker",
     "type": "string",
     "label": "Label above the title"
    }
   ]
  },
  {
   "name": "gfm-two-chart",
   "description": "Two charts side by side (height about 300 each). Put the first chart, then a line with ::right:: and the second.",
   "slots": [
    "default",
    "right"
   ],
   "props": [
    {
     "name": "heading",
     "type": "string",
     "label": "Slide title"
    },
    {
     "name": "kicker",
     "type": "string",
     "label": "Label above the title"
    }
   ]
  }
 ],
 "components": [
  {
   "name": "GfmBigNumber",
   "category": "GFM content",
   "description": "One number shown large, with its label, the change from before and a short note.",
   "snippet": "<GfmBigNumber value=\"47\" label=\"New people being taught\" change=\"+6 from last week\" tone=\"good\" />",
   "props": [
    {
     "name": "value",
     "type": "string",
     "label": "The number"
    },
    {
     "name": "label",
     "type": "string",
     "label": "What it counts"
    },
    {
     "name": "change",
     "type": "string",
     "label": "Change (for example +6 from last week)"
    },
    {
     "name": "tone",
     "type": "'good' | 'warn' | 'bad' | 'neutral'",
     "label": "Colour of the change",
     "options": [
      "good",
      "warn",
      "bad",
      "neutral"
     ]
    },
    {
     "name": "note",
     "type": "string",
     "label": "Note under the number"
    }
   ],
   "slot": false
  },
  {
   "name": "GfmCallout",
   "category": "GFM content",
   "description": "A box that points something out - an invitation, a reminder or a warning - with a small heading.",
   "snippet": "<GfmCallout title=\"Invitation\" tone=\"info\">\nInvite one friend this week.\n</GfmCallout>",
   "props": [
    {
     "name": "title",
     "type": "string",
     "label": "Heading"
    },
    {
     "name": "tone",
     "type": "'info' | 'good' | 'warn' | 'bad'",
     "label": "Kind",
     "options": [
      "info",
      "good",
      "warn",
      "bad"
     ]
    }
   ],
   "slot": true
  },
  {
   "name": "GfmComparison",
   "category": "GFM content",
   "description": "Two numbers side by side with the change between them - this week and last week, or two zones.",
   "snippet": "<GfmComparison leftLabel=\"Last week\" :leftValue=\"41\" rightLabel=\"This week\" :rightValue=\"47\" />",
   "props": [
    {
     "name": "leftLabel",
     "type": "string",
     "label": "Left label"
    },
    {
     "name": "leftValue",
     "type": "number",
     "label": "Left number"
    },
    {
     "name": "rightLabel",
     "type": "string",
     "label": "Right label"
    },
    {
     "name": "rightValue",
     "type": "number",
     "label": "Right number"
    },
    {
     "name": "unit",
     "type": "string",
     "label": "Unit after the numbers (for example %)"
    }
   ],
   "slot": false
  },
  {
   "name": "GfmInsight",
   "category": "GFM content",
   "description": "What the numbers mean, in one or two sentences, set apart with a teal bar.",
   "snippet": "<GfmInsight>\nMost zones taught more people than last week.\n</GfmInsight>",
   "props": [
    {
     "name": "label",
     "type": "string",
     "label": "Small heading"
    }
   ],
   "slot": true
  },
  {
   "name": "GfmKpi",
   "category": "GFM data",
   "description": "One key indicator of the mission as a tile - the last finished week against the goal set the week before, with a small line of the weeks. Live from the weekly plans.",
   "snippet": "<GfmKpi metric=\"New people being taught\" />",
   "props": [
    {
     "name": "weeks",
     "type": "number",
     "label": "Weeks in the small line (1-104)"
    },
    {
     "name": "height",
     "type": "number",
     "label": "Height (slide pixels)"
    },
    {
     "name": "highlight",
     "type": "boolean",
     "label": "Outline in teal (the first, most important number)"
    }
   ],
   "slot": false
  },
  {
   "name": "GfmKpiGrid",
   "category": "GFM data",
   "description": "Key indicators of the mission as a grid of tiles, live from the weekly plans. Choose which ones, how many weeks the small lines show, and whether the first is outlined.",
   "snippet": "<GfmKpiGrid metrics=\"friends_found,baptismal_dates,sacrament_attendance\" />",
   "props": [
    {
     "name": "metrics",
     "type": "string",
     "label": "Key indicators, separated by commas (empty = all six)"
    },
    {
     "name": "weeks",
     "type": "number",
     "label": "Weeks in each small line (1-104)"
    },
    {
     "name": "columns",
     "type": "number",
     "label": "Tiles across (0 = automatic)"
    },
    {
     "name": "highlightFirst",
     "type": "boolean",
     "label": "Outline the first tile"
    }
   ],
   "slot": false
  },
  {
   "name": "GfmProgress",
   "category": "GFM content",
   "description": "How far along a goal is: a bar with the numbers and the percentage.",
   "snippet": "<GfmProgress label=\"Baptismal dates\" :value=\"31\" :goal=\"40\" />",
   "props": [
    {
     "name": "label",
     "type": "string",
     "label": "What is measured"
    },
    {
     "name": "value",
     "type": "number",
     "label": "Reached so far"
    },
    {
     "name": "goal",
     "type": "number",
     "label": "Goal"
    },
    {
     "name": "unit",
     "type": "string",
     "label": "Unit after the numbers (for example %)"
    }
   ],
   "slot": false
  },
  {
   "name": "GfmQuote",
   "category": "GFM content",
   "description": "A quotation or scripture, large, with the source underneath.",
   "snippet": "<GfmQuote author=\"Alma 37:6\">\nBy small and simple things are great things brought to pass.\n</GfmQuote>",
   "props": [

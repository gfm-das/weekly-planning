# The portal (nginx) needs no secrets. These names are optional settings, read by portal/portal-compose.yml,
# portal/deploy.ps1, health.ps1 and the updater. The defaults are this server's. A new install can choose its own,
# BEFORE the first start (put them in this file, or set them as Windows environment variables for every script).
#
# The portal container's name.
# GFM_PORTAL_CONTAINER=portal
# The Docker volume that holds the served pages. Create it once: docker volume create <name>
# GFM_PORTAL_VOLUME=portal-data
#
# This computer's address in the office network (the portal is then http://<address>:8070). Also used by the
# Dashboards, Presentations and database settings.
# GFM_HOST_IP=192.168.1.20
#
# The mission's public web name, for example example.org (the portal pages then also work on it, and use
# presentations.<name>, decks.<name>, dashboards.<name> and management.<name>). Empty: no public address.
# GFM_PUBLIC_DOMAIN=
#
# The mission's time zone (an IANA name such as America/Denver). It decides which week a moment belongs to, when the Sunday reminders
# go out and which times the pages show. Default: Europe/Berlin.
# GFM_TIME_ZONE=Europe/Berlin
